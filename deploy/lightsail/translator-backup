#!/usr/bin/env bash
# Forced command for a backup SSH key (install as /usr/local/bin/translator-backup). The key can run only
# `backup`, which writes an age-encrypted, gzipped copy of the database to stdout.
#
# The copy is taken with SQLite's backup API (WAL mode, so a file copy could be torn), held in memory,
# gzipped, and encrypted with age to the public key in $RECIPIENTS before it leaves the box. The box never
# holds the private key, and the caller can't choose the recipient.
set -euo pipefail
DIR=${TRANSLATOR_DIR:-$HOME/translator/deploy/lightsail}
VOLUME=translator_data
RECIPIENTS=/usr/local/etc/translator-backup.age.pub

[[ ${SSH_ORIGINAL_COMMAND:-backup} == backup ]] \
  || { echo "usage: backup (the encrypted copy goes to stdout)" >&2; exit 2; }
[[ -s $RECIPIENTS ]] || { echo "no age recipient in $RECIPIENTS" >&2; exit 1; }
[[ ! -t 1 ]] || { echo "refusing to write the encrypted copy to a terminal" >&2; exit 2; }

TAG=$(sed -n 's/^TRANSLATOR_TAG=//p' "$DIR/.env" 2>/dev/null || true)
docker run --rm -i --pull never --network none -v "$VOLUME:/data" "translator:${TAG:-latest}" python - <<'PY' |
import gzip, sqlite3, sys
src = sqlite3.connect("file:/data/translator.db?mode=ro", uri=True)
dst = sqlite3.connect(":memory:")
src.backup(dst)
data = dst.serialize()
if len(data) < 4096:
    sys.exit(f"copy is only {len(data)} bytes")
sys.stdout.buffer.write(gzip.compress(data, mtime=0))
PY
  age -R "$RECIPIENTS"
